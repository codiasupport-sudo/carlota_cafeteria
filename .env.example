# Dirección pública del menú digital comensal (independiente).
# Si no se define, se utilizará la URL fallback por defecto.
NEXT_PUBLIC_DIGITAL_MENU_URL=https://la-carlota-menu-digital.vercel.app/m

# --- Catálogo (Etapa 2) ---
# Con estas dos variables el menú usa Supabase; sin ellas funciona en modo demo (datos/menu-inicial.json).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Necesaria para que el panel /app/menu escriba. NUNCA con prefijo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# Sin Supabase, en producción el panel es de solo lectura. 1 = permitir escrituras demo (solo memoria, no persisten).
# MENU_DEMO_WRITES=1
